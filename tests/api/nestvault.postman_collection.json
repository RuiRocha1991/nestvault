              ],
              "path": [
                "api",
                "v1",
                "me",
                "sessions",
                "{{otherSessionId}}"
              ]
            },
            "description": "204 when it is yours; 404 for somebody else's, an unknown or a malformed id. The Origin header is added by the collection pre-request script."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 or 404 when it is already gone', () => pm.expect([204,404]).to.include(pm.response.code));"
