# env-version: 2
# Bump the number above whenever a variable is added, renamed or removed, and add a line to
# "Environment versions" in docs/dev-setup.md. `pnpm env:check` compares it with your .env.local.
#
# Copy to .env.local with `pnpm env:init` (it fills every __PLACEHOLDER__ with a random value).
# .env.local is never committed. Do not put real secrets in this file.

# --- Postgres (docker-compose.yml) ---
# Port published on 127.0.0.1. 5433 avoids a clash with a Postgres already using 5432 (e.g. on the Mac).
POSTGRES_PORT=__POSTGRES_PORT__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
IDENTITY_RW_PASSWORD=__IDENTITY_RW_PASSWORD__
APP_RW_PASSWORD=__APP_RW_PASSWORD__
MIGRATOR_PASSWORD=__MIGRATOR_PASSWORD__

# --- Runtime connections (server only) ---
DATABASE_URL_IDENTITY=postgres://identity_rw:__IDENTITY_RW_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/nestvault_identity
DATABASE_URL_APP=postgres://app_rw:__APP_RW_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/nestvault_app

# --- Migrations only (owner of the schemas) ---
MIGRATOR_URL_IDENTITY=postgres://nestvault_migrator:__MIGRATOR_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/nestvault_identity
MIGRATOR_URL_APP=postgres://nestvault_migrator:__MIGRATOR_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/nestvault_app

# --- Test databases ---
TEST_DATABASE_URL_IDENTITY=postgres://identity_rw:__IDENTITY_RW_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/nestvault_identity_test
TEST_DATABASE_URL_APP=postgres://app_rw:__APP_RW_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/nestvault_app_test
TEST_MIGRATOR_URL_IDENTITY=postgres://nestvault_migrator:__MIGRATOR_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/nestvault_identity_test
TEST_MIGRATOR_URL_APP=postgres://nestvault_migrator:__MIGRATOR_PASSWORD__@127.0.0.1:__POSTGRES_PORT__/nestvault_app_test

# --- Application ---
# The dev server listens on 4000 (3000 is often taken by other apps).
APP_URL=http://localhost:4000
ALLOW_SIGNUP=false
# Swagger UI at /api/docs (local development only; ignored when NODE_ENV=production).
ENABLE_API_DOCS=true
BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__
APP_ENCRYPTION_KEY=__APP_ENCRYPTION_KEY__
# The only variable the browser may read (explicit allow-list in packages/config/src/public.ts).
NEXT_PUBLIC_APP_NAME=Cofre Familiar

# --- Email (Mailpit in development: SMTP 1025, UI http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NestVault <no-reply@nestvault.local>"
