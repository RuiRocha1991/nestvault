{
  "$defs": {
    "BankRow": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bank",
          "title": "Kind",
          "type": "string"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "description": {
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "amount": {
          "maxLength": 40,
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Amount",
          "type": "string"
        },
        "balance": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balance"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "transfer",
                "card",
                "interest",
                "trade",
                "dividend",
                "fee",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "kind",
        "date",
        "description",
        "amount"
      ],
      "title": "BankRow",
      "type": "object"
    },
    "BrokerRow": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "broker",
          "title": "Kind",
          "type": "string"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "type": {
          "enum": [
            "buy",
            "sell",
            "dividend",
            "tax",
            "refund",
            "deposit",
            "withdrawal",
            "fee",
            "interest"
          ],
          "title": "Type",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "quantity": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "price": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "amount": {
          "maxLength": 40,
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "holder": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holder"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "subaccount": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subaccount"
        },
        "asset_type": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Type"
        },
        "fee": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee"
        },
        "tax": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax"
        }
      },
      "required": [
        "kind",
        "date",
        "type",
        "amount",
        "currency"
      ],
      "title": "BrokerRow",
      "type": "object"
    },
    "ParseMeta": {
      "additionalProperties": false,
      "properties": {
        "parser_id": {
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "opening_balance": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opening Balance"
        },
        "closing_balance": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closing Balance"
        },
        "reconciled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconciled"
        },
        "account_hint": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Hint"
        },
        "subaccounts": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "title": "Subaccounts",
          "type": "array"
        }
      },
      "required": [
        "parser_id",
        "parser_version",
        "row_count"
      ],
      "title": "ParseMeta",
      "type": "object"
    },
    "PriceEntry": {
      "additionalProperties": false,
      "description": "A quote the file states (for example the fund price on the report date).",
      "properties": {
        "symbol": {
          "maxLength": 500,
          "title": "Symbol",
          "type": "string"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "price": {
          "maxLength": 40,
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Price",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "date",
        "price",
        "currency"
      ],
      "title": "PriceEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rows": {
      "items": {
        "discriminator": {
          "mapping": {
            "bank": "#/$defs/BankRow",
            "broker": "#/$defs/BrokerRow"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BankRow"
          },
          {
            "$ref": "#/$defs/BrokerRow"
          }
        ]
      },
      "title": "Rows",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/ParseMeta"
    },
    "warnings": {
      "items": {
        "maxLength": 500,
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "prices": {
      "items": {
        "$ref": "#/$defs/PriceEntry"
      },
      "title": "Prices",
      "type": "array"
    }
  },
  "required": [
    "rows",
    "meta",
    "warnings"
  ],
  "title": "ParseResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nestvault.local/schemas/parse-response.json"
}
