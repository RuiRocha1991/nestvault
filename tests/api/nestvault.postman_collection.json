                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has no password or token', () => pm.expect(pm.response.text()).to.not.match(/token|password/i));",
                  "pm.test('lists pools', () => pm.expect(pm.response.json().pools).to.be.an('array'));"
                ]
              }
