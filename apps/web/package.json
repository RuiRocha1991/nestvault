{
  "name": "@nestvault/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local ./node_modules/next/dist/bin/next dev -p 4000",
    "build": "next build",
    "start": "node --env-file-if-exists=../../.env.local ./node_modules/next/dist/bin/next start -p 4000",
    "typecheck": "next typegen && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@nestvault/config": "workspace:*",
    "@nestvault/services": "workspace:*",
    "@nestvault/ui": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "autoprefixer": "^10.6.1",
    "better-auth": "^1.7.7",
    "lucide-react": "^1.55.0",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swagger-ui-dist": "^5.33.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
