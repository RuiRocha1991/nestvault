{
  "name": "nestvault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @nestvault/web dev",
    "dev:worker": "pnpm --filter @nestvault/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project web --project worker --project domain --project services --project db --project ui --project config --project lint",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "env:init": "bash scripts/init-env.sh",
    "env:check": "tsx scripts/env-check.ts",
    "env:sync": "tsx scripts/env-check.ts --sync",
    "gen:secret": "node scripts/gen-secret.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait",
    "db:down": "docker compose --env-file .env.local down",
    "db:reset": "bash scripts/db-reset.sh",
    "db:check": "bash scripts/db-check.sh",
    "db:psql:identity": "docker compose --env-file .env.local exec postgres psql -U identity_rw -d nestvault_identity",
    "db:psql:app": "docker compose --env-file .env.local exec postgres psql -U app_rw -d nestvault_app",
    "db:generate:identity": "pnpm --filter @nestvault/db db:generate:identity",
    "db:generate:app": "pnpm --filter @nestvault/db db:generate:app",
    "db:migrate": "pnpm --filter @nestvault/db db:migrate",
    "db:seed": "echo 'db:seed: seed arrives with the first tables'",
    "openapi": "tsx scripts/openapi.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestvault/config": "workspace:*",
    "@nestvault/db": "workspace:*",
    "@nestvault/domain": "workspace:*",
    "@nestvault/services": "workspace:*",
    "@nestvault/ui": "workspace:*",
    "@nestvault/web": "workspace:*",
    "@nestvault/worker": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.6"
  }
}
