    {
      "name": "Invites",
      "item": [
        {
          "name": "Invite somebody to the pool",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pools/{{poolId}}/invites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pools",
                "{{poolId}}",
                "invites"
              ]
            },
            "description": "Needs members.invite (owner, admin). Sends a pt-PT email (see Mailpit at http://localhost:8025) with a single-use link valid for 7 days. The role cannot be above your own. 20 invites a day per pool.",
            "body": {
              "mode": "raw",
